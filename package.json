{
  "name": "mobile-automation-appium",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "postinstall": "node scripts/sync-appium-manifest.mjs",
    "test": "wdio run wdio.conf.ts",
    "test:android": "wdio run wdio.conf.ts",
    "test:smoke": "wdio run wdio.conf.ts --suite smoke",
    "test:regression": "wdio run wdio.conf.ts --suite regression",
    "test:all": "wdio run wdio.conf.ts",
    "report:allure": "allure generate reports/allure-results --clean -o reports/allure-report"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.4",
    "@wdio/allure-reporter": "^9.32.0",
    "@wdio/appium-service": "^9.32.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
